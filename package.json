{
  "name": "sitecraft-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoryGraman/sitecraft.git"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:harness": "pnpm --filter @sitecraft/extension run build:harness && pnpm --filter sitecraft run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
